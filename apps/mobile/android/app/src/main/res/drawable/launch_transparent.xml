<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ requires a system launch icon drawable. Keep it invisible against
  the navy launch background so native Flutter V2 Screen 01 is the only visible
  branded launch screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
