    "failClosedWhenClassificationOrDisclosureIsMissing": true,
    "robust60To75DayDeliveryLockRequired": true,
    "preTicketSelectionReuseAssessmentRequired": true,
    "noDuplicateScreensRoutesOrBackendOwnersPerUserType": true,
    "ticketCountDoesNotImplyImplementationOwnerCount": true,
    "newImplementationOwnerRequiresNecessityProof": true,
    "robustnessCannotBeReducedForTimeline": true,
    "sqlConnectSingleAuthoritativeMappingAfterCompleteContracts": true,
    "sqlConnectMultipleAttemptsAndDuplicateMigrationsForbidden": true,
    "sqlConnectPartialBusinessLogicSchemaForbidden": true,
    "sqlConnectPreCompletionScopeLimitedToCompleteSharedGlobalCapabilities": true
  }
