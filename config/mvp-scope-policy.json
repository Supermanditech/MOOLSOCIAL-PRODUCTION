  "preExecutionDisclosureFields": [
    "ticketId",
    "customerOutcome",
    "classification",
    "classificationReason",
    "minimumCompleteScope",
    "explicitExclusions",
    "dependenciesAndApprovals",
    "testAndEvidencePlan",
    "robustnessAndReuseAssessment"
  ],
  "sqlConnectCompletionRule": {
    "state": "founder_locked_active",
    "authorityDate": "2026-08-22",
    "singleAuthoritativeDatabaseMapping": true,
    "mappingEntryCondition": "complete_frontend_ui_ux_api_business_logic_ownership_failure_recovery_privacy_retention_and_authoritative_data_contracts",
    "multipleProvisioningAttemptsAllowed": false,
    "duplicateOrRepeatedMigrationsAllowed": false,
    "partialOrUnderdevelopedBusinessLogicSchemaAllowed": false,
    "provisionalMainOrSubactionDomainSchemaAllowed": false,
    "preCompletionBackendScope": [
      "already_complete_shared_global_capabilities",
      "shared_authentication_login_and_account_erasure",
      "explicitly_separate_locally_emulated_or_existing_non_sql_connect_backends"
    ],
    "preCompletionExcludedScope": [
      "unfinished_main_action_business_logic",
      "unfinished_subaction_business_logic",
      "unapproved_api_contracts",
      "speculative_domain_tables_relationships_or_migrations"
    ],
    "currentSqlConnectProvisioningAuthorized": false,
    "currentSqlConnectMigrationAuthorized": false,
    "founderReactivationRequiresCompleteDatabaseMapAndFreshExactAuthorization": true
