  "rules": {
    "discloseBeforeExecution": true,
    "preferSmallestCompleteJourney": true,
    "oneLogicalTicketAtATime": true,
    "noOpportunisticExpansion": true,
    "mvpClassificationDoesNotCreateAuthority": true,
    "beyondMvpRequiresSeparateExactFounderAuthorization": true,
