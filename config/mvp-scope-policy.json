    "owned_long_form_video_universal_ai_agents_or_unapproved_provider_scope",
    "speculative_ten_million_user_scaling_without_a_measured_launch_bottleneck",
    "opportunistic_redesign_animation_or_platform_work_not_needed_by_the_ticket"
  ],
  "founderApprovedBoundedMvpSurfaces": [
